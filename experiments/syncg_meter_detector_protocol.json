{
  "schema_version": 1,
  "protocol": "syncg_public_meter_detector_experiment_v1",
  "status": "frozen_before_training",
  "purpose": "Train one shared full-scene meter detector without target-domain access so every final method receives the identical automatically detected ROI.",
  "data_scope": {
    "dataset": "SyncG",
    "allowed_split": "train",
    "expected_images": 16000,
    "expected_physical_groups": 725,
    "annotation": "dial_bbox_annotations",
    "forbidden_inputs": [
      "field",
      "test",
      "sealed",
      "confirmatory"
    ]
  },
  "partition": {
    "unit": "physical_group",
    "method": "two-stage SHA256 physical-group ordering",
    "seed": 20260819,
    "calibration_fraction": 0.1,
    "validation_fraction": 0.1,
    "selection_partition": "calibration",
    "validation_model_inference_and_metrics_after_selection_claim": true,
    "validation_format_integrity_preflight_allowed": true
  },
  "model": {
    "family": "Ultralytics YOLO11n detection",
    "initial_checkpoint": {
      "public_url": "https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo11n.pt",
      "asset_release": "v8.3.0",
      "bytes": 5613764,
      "sha256": "0ebbc80d4a7680d14987a577cd21342b65ecfd94632bd9a8da63ae6417644ee1"
    },
    "classes": {
      "0": "meter"
    },
    "image_size": 640,
    "epochs_maximum": 60,
    "early_stopping_patience": 12,
    "batch_size": 16,
    "optimizer": "AdamW",
    "initial_learning_rate": 0.001,
    "weight_decay": 0.0005,
    "deterministic": true,
    "amp": true,
    "runtime": {
      "requirements_lock_path": "experiments/requirements-training.lock.txt",
      "requirements_lock_sha256": "b3e2a46c20ad645e4b0ff1b95edc39d22d5e35e9f39e872a6dbb410b25f75035",
      "ultralytics_version": "8.4.102",
      "ultralytics_distribution_record_sha256": "773d5b53f4b740b1b2cb6ffa3487178881f7650813c6333f78e3ae6b70f2862b",
      "critical_source_sha256": {
        "cfg/default.yaml": "6abe4641db08d713bea4d49b8737956e1d1fc59332c37936ac42de44216fa631",
        "engine/trainer.py": "1e6bffd65b16a5fa64bf8e2b367280af69403f731c2b4ac830d776a3b8c7e39e",
        "models/yolo/detect/train.py": "257f81fcbce922e9032f6d3908378f6e1d1b0648169d72f4a37f1448d2afb81e",
        "models/yolo/detect/val.py": "55068be1bd32ddc3491cfe3b0bf5149ceb46fd301abf0026e6699264f696456a",
        "utils/metrics.py": "0d0754ad72a1a80654a6a40e179f02c37a20c9bd7ff1fc6fbd4d497944a6a38c"
      }
    }
  },
  "selection": {
    "checkpoint_rule": "maximum calibration mAP50-95; Ultralytics latest epoch attaining the maximum is retained on exact ties",
    "confidence_rule": "deterministic 0.05..0.95 grid; require calibration IoU50 recall >= 0.995 when feasible, then maximize selected-box F1, mean IoU, and threshold",
    "box_rule": "highest confidence then xyxy lexicographic",
    "fixed_padding_fraction": 0.05,
    "prediction_confidence_floor": 0.001,
    "prediction_nms_iou": 0.7,
    "runtime_integer_box_quantization": "truncate_nonnegative_xyxy_then_frame_clamp"
  },
  "independent_validation_gate": {
    "selected_box_iou50_recall_minimum": 0.99,
    "selected_box_precision_minimum": 0.99,
    "mean_selected_iou_minimum": 0.85,
    "ultralytics_map50_minimum": 0.99,
    "ultralytics_map50_95_minimum": 0.85
  },
  "frontend_contract": {
    "runtime_class": "targetDetectModel",
    "input": "original_full_scene_bgr_uint8",
    "fallback_to_full_frame": false,
    "same_roi_for_all_methods": true,
    "caller_bbox_allowed": false,
    "caller_crop_allowed": false,
    "ground_truth_geometry_allowed": false,
    "correction_or_warp_applied": false
  },
  "legacy_checkpoint_rejection": {
    "artifact": "utils/angleDetect/yoloDetection/result/yolo_findMeter.pt",
    "sha256": "98b8f40cba170b40f828bd0579e6a8a5feba500fd83261a13651ab428c0956ab",
    "eligible_as_frozen_frontend": false
  },
  "notification_policy": {
    "allowed": [
      "whole_detector_run_complete",
      "unexpected_stop",
      "confirmed_key_metric",
      "stage_switch"
    ],
    "forbidden": [
      "epoch_progress",
      "heartbeat",
      "unchanged_status"
    ],
    "stable_event_key_required": true
  }
}
